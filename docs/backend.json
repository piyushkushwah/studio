
{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A productivity task with due date and priority",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "label": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "required": ["description", "dueDate", "completed", "createdAt"]
    },
    "Routine": {
      "title": "Routine",
      "description": "A recurring set of activities or habits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startTime": { "type": "string", "description": "HH:MM format" },
        "endTime": { "type": "string", "description": "HH:MM format" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "weekdays", "weekends"] },
        "days": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "frequency", "active", "createdAt"]
    },
    "Label": {
      "title": "Label",
      "description": "Custom category labels for tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["name", "color"]
    },
    "Session": {
      "title": "Focus Session",
      "description": "A recorded Pomodoro or focus session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "startTime": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "type": { "type": "string", "enum": ["work", "short", "manual"] },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      },
      "required": ["startTime", "durationMinutes", "type", "date"]
    },
    "Note": {
      "title": "Note",
      "description": "A simple text note for quick thoughts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["content", "createdAt", "updatedAt"]
    },
    "GrowthNote": {
      "title": "Growth Note",
      "description": "Adhyatmic or self-improvement reflection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["reflection", "gratitude", "affirmation", "lesson"] },
        "source": { "type": "string", "description": "Guru name or Book name" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "number" }
      },
      "required": ["content", "type", "date", "createdAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A financial transaction for tracking spending",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "number" }
      },
      "required": ["amount", "currency", "category", "description", "date", "createdAt"]
    },
    "DietEntry": {
      "title": "Diet Entry",
      "description": "A log of food consumption",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "calories": { "type": "number" },
        "mealType": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"] },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "mealType", "date", "createdAt"]
    },
    "WaterEntry": {
      "title": "Water Entry",
      "description": "A log of water consumption in milliliters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "number" }
      },
      "required": ["amount", "date", "createdAt"]
    },
    "Exercise": {
      "title": "Exercise",
      "description": "A record of physical activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "caloriesBurned": { "type": "number" },
        "type": { "type": "string", "enum": ["cardio", "strength", "flexibility", "other"] },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "durationMinutes", "caloriesBurned", "type", "date", "createdAt"]
    },
    "TravelGoal": {
      "title": "Travel Goal",
      "description": "A travel destination and planning details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "destination": { "type": "string" },
        "plannedDate": { "type": "string", "format": "date" },
        "budget": { "type": "number" },
        "status": { "type": "string", "enum": ["planned", "bucket-list", "completed"] },
        "notes": { "type": "string" },
        "packingList": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" }
      },
      "required": ["destination", "status", "createdAt"]
    },
    "UserPreference": {
      "title": "User Preference",
      "description": "User specific settings including custom songs and goals",
      "type": "object",
      "properties": {
        "dailyGoals": { 
          "type": "object", 
          "additionalProperties": { "type": "number" } 
        },
        "waterGoal": { "type": "number" },
        "calorieGoal": { "type": "number" },
        "height": { "type": "number", "description": "Height in cm" },
        "weight": { "type": "number", "description": "Weight in kg" },
        "customSongs": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["google"]
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/backend/entities/Task" },
      "description": "Individual tasks for the user"
    },
    "/users/{userId}/routines/{routineId}": {
      "schema": { "$ref": "#/backend/entities/Routine" },
      "description": "Recurring routines for the user"
    },
    "/users/{userId}/labels/{labelId}": {
      "schema": { "$ref": "#/backend/entities/Label" },
      "description": "Custom task labels defined by the user"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/backend/entities/Session" },
      "description": "Recorded productivity sessions"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/backend/entities/Note" },
      "description": "Personal notes for the user"
    },
    "/users/{userId}/growthNotes/{noteId}": {
      "schema": { "$ref": "#/backend/entities/GrowthNote" },
      "description": "Self-improvement and Adhyatmic notes"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/backend/entities/Expense" },
      "description": "User financial expenses"
    },
    "/users/{userId}/diet/{dietId}": {
      "schema": { "$ref": "#/backend/entities/DietEntry" },
      "description": "User daily food log"
    },
    "/users/{userId}/water/{waterId}": {
      "schema": { "$ref": "#/backend/entities/WaterEntry" },
      "description": "User daily water intake log"
    },
    "/users/{userId}/exercises/{exerciseId}": {
      "schema": { "$ref": "#/backend/entities/Exercise" },
      "description": "User physical activity log"
    },
    "/users/{userId}/travelGoals/{goalId}": {
      "schema": { "$ref": "#/backend/entities/TravelGoal" },
      "description": "User travel planning and goals"
    },
    "/users/{userId}/preferences/main": {
      "schema": { "$ref": "#/backend/entities/UserPreference" },
      "description": "User specific global settings"
    }
  }
}
